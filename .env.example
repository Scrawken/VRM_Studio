# VRM Forge Studio local configuration. Copy to .env (optional). Never commit .env.
# Bash/Git Bash: cp .env.example .env     PowerShell: Copy-Item .env.example .env

# Optional: Gemini character interpretation (network call to Google). Leave empty for the local parser.
GEMINI_API_KEY=

# Optional: external geometry providers (network calls to Tripo / Meshy).
# TRIPO_API_KEY=
# MESHY_API_KEY=

# Server listen port (default 3000, 0 = random free port). Host stays 127.0.0.1 unless
# VRM_FORGE_ALLOW_NON_LOOPBACK=1 is also set (not recommended).
# PORT=3000
# VRM_FORGE_HOST=127.0.0.1
