{
  "name": "vrm-forge-desktop",
  "version": "1.0.0",
  "description": "Windows Desktop Electron shell for VRM Forge Studio",
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "start": "npm run build:ts && electron .",
    "package:win": "npm run build:ts && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.vrmforge.studio",
    "productName": "VRM Forge Studio",
    "win": {
      "target": ["nsis", "portable"]
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend"
      },
      {
        "from": "../blender_scripts",
        "to": "blender_scripts"
      }
    ]
  }
}
